# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Dados (extraídos do BigQuery — reproduzíveis via `make data`)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Modelos treinados e vetores de probabilidade: reproduzíveis via `make modelo-a` /
# `make modelo-b`, e grandes demais para versionar (o .npy do teste tem 37 MiB).
models/*
!models/.gitkeep
reports/*.npy

# Credenciais — a regra ampla existe porque chaves de service account do GCP são
# arquivos .json; as exceções liberam os artefatos legítimos do projeto.
*.json
!config/*.json
# (o .gitignore não aceita comentário na mesma linha do padrão — ele vira parte dela)
# manifesto das features de cada desenho, artefato de reprodutibilidade:
!reports/*.json
# notebooks são JSON por dentro:
!notebooks/*.ipynb
.env

# Sistema
.DS_Store
